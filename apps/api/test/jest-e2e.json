{
  "rootDir": "..",
  "testMatch": [
    "<rootDir>/test/**/*.e2e-spec.ts"
  ],
  "moduleFileExtensions": [
    "ts",
    "js",
    "json"
  ],
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/test/tsconfig.e2e.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testEnvironment": "node",
  "testTimeout": 30000
}
